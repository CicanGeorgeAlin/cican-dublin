{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cicangeorgealin.github.io/cican-dublin-archive/schemas/district.schema.json",
  "title": "CICAN Dublin Archive Research Zone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "status"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_YET_RESEARCHED",
        "RESEARCH_IN_PROGRESS",
        "INITIAL_RESEARCH_COMPLETE",
        "FIELDWORK_IN_PROGRESS",
        "FIELDWORK_REVIEWED"
      ]
    },
    "geographic_type": {
      "type": "string",
      "enum": [
        "POSTAL_DISTRICT",
        "LOCAL_AUTHORITY",
        "NEIGHBOURHOOD",
        "TOWNLAND",
        "PARK",
        "CORRIDOR",
        "COASTAL_ZONE",
        "OTHER"
      ]
    },
    "parent_zone": {
      "type": "string"
    },
    "coverage_notes": {
      "type": "string"
    }
  }
}
