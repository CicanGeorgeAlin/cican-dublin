{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cicangeorgealin.github.io/cican-dublin/schemas/evidence-claim.schema.json",
  "title": "CICAN DUBLIN Object Evidence Claim",
  "description": "A separately assessable factual claim about one catalogue object, linked to its evidence and limitations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "object_id",
    "claim_text",
    "claim_type",
    "source_ids",
    "assessment",
    "evidence_grade",
    "limits",
    "reviewed_on"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CLM-[A-Z0-9-]+$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^DUB-[A-Z]{3}-[0-9]{4,}$"
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "IDENTITY",
        "DATE",
        "AUTHORSHIP",
        "LOCATION",
        "MATERIAL",
        "HISTORICAL_USE",
        "SIGNIFICANCE",
        "CONDITION",
        "ACCESS",
        "OTHER"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "PARTIALLY_SUPPORTED",
        "CONTRADICTED",
        "UNRESOLVED"
      ]
    },
    "evidence_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CLM-[A-Z0-9-]+$"
    }
  }
}
