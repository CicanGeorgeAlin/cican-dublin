{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cicangeorgealin.github.io/cican-dublin/schemas/source.schema.json",
  "title": "CICAN DUBLIN Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "publisher",
    "url",
    "accessed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "accessed": {
      "type": "string",
      "format": "date"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "ACADEMIC",
        "ARCHIVAL_ACCESS_GUIDANCE",
        "ARCHIVAL_CATALOGUE",
        "ARCHIVAL_COLLECTION_SEARCH",
        "ARCHIVAL_PHOTOGRAPH_CATALOGUE_RECORD",
        "ARCHIVAL_WILL_ABSTRACT_COLLECTION",
        "ARCHIVE",
        "ARTIST_BIOGRAPHICAL_REFERENCE",
        "BIOGRAPHICAL_REFERENCE",
        "CONTEMPORARY_DIRECTORY",
        "CONTEMPORARY_TOPOGRAPHICAL_DICTIONARY",
        "GEOGRAPH_PHOTOGRAPH",
        "GOVERNMENT",
        "GOVERNMENT_REPORT",
        "HISTORIC_MAP_CATALOGUE",
        "HISTORIC_MAP_VIEWER",
        "HISTORIC_PRINT_CATALOGUE",
        "IMAGE_REFERENCE",
        "IMAGE_REFERENCE_VISUALLY_VERIFIED",
        "LOCAL_HISTORY_BOOK",
        "MANUSCRIPT_LAND_SURVEY",
        "OFFICIAL_HERITAGE_PHOTOGRAPH",
        "OFFICIAL_HERITAGE_PHOTOGRAPH_GALLERY",
        "OFFICIAL_HERITAGE_PHOTOGRAPH_GALLERY_VISUALLY_VERIFIED",
        "OFFICIAL_HERITAGE_REGISTER",
        "OFFICIAL_POLICY",
        "OFFICIAL_REGISTER",
        "OFFICIAL_REGISTER_WITH_PHOTOGRAPH_GALLERY",
        "OFFICIAL_REPORT",
        "OTHER",
        "PRIMARY_DOCUMENT",
        "PRIMARY_MANUSCRIPT_MAP_CATALOGUE",
        "RESEARCH_GUIDE",
        "SECONDARY_HISTORICAL_MAP_REFERENCE",
        "SECONDARY_RESEARCH",
        "SECONDARY_TRANSCRIPTION_COMPILATION",
        "THIRD_PARTY_PHOTOGRAPH",
        "TRANSCRIBED_HISTORICAL_LETTER"
      ]
    },
    "specific_reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
