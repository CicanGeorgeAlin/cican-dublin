{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cicangeorgealin.github.io/cican-dublin/schemas/taxonomy.schema.json",
  "title": "CICAN DUBLIN Controlled Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "purpose",
    "category_codes",
    "feature_types",
    "classification_rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "category_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "label",
          "description",
          "examples"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "feature_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "definition"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SITE",
              "PRIMARY_OBJECT",
              "MICRO_DETAIL",
              "SURFACE_OR_SEQUENCE"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "classification_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
